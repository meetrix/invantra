# Copy this file to .env and fill it in; .env is git-ignored.

# PostgreSQL connection. `npm run dev:db` starts a local one at this address.
DATABASE_URL=postgres://invoice@localhost:5433/invoice

# Port the server listens on.
PORT=8787

# The first admin account. It is created on startup only while no user exists,
# and must change this password at first login. Both can be removed afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-first-login

# Session cookies are marked Secure in production, which browsers only accept
# over HTTPS. Set this to false to run a production build over plain HTTP.
# COOKIE_SECURE=false
